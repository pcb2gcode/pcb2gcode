{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "gerbv Git tag built from source in CI (GERBV_GIT_TAG)",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "GERBV_GIT_TAG:\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "gerbv/gerbv",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "GEOS release tag built from source in CI (&geos_version in matrix)",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "&geos_version\\s+'(?<currentValue>\\d+\\.\\d+\\.\\d+)'",
        "&geos_version\\s+\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "geos",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "libgeos/geos",
      "versioningTemplate": "semver"
    }
  ]
}
